<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MusicPlayer"
             xmlns:components="clr-namespace:MusicPlayer.Components"
             x:Class="MusicPlayer.MainPage"
             BackgroundColor="#101514">

    <local:LibraryBlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" BackgroundColor="#101514"
                   BlazorWebViewInitialized="OnBlazorWebViewInitialized">
        <local:LibraryBlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </local:LibraryBlazorWebView.RootComponents>
    </local:LibraryBlazorWebView>

</ContentPage>
