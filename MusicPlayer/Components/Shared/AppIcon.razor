<svg class="app-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "play": <path d="m9 5 11 7-11 7z" fill="currentColor" stroke="none" /> break;
        case "pause": <path d="M8 5v14M16 5v14" stroke-width="4" /> break;
        case "next": <path d="m5 5 10 7-10 7z" fill="currentColor" stroke="none" /><path d="M19 5v14" stroke-width="2.5" /> break;
        case "previous": <path d="m19 5-10 7 10 7z" fill="currentColor" stroke="none" /><path d="M5 5v14" stroke-width="2.5" /> break;
        case "home": <path d="m3 10 9-7 9 7v10H7V10" /><path d="M10 20v-6h4v6" /> break;
        case "search": <circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /> break;
        case "library": <rect x="3" y="5" width="4" height="15" rx="1" /><path d="M11 5v15M15 5l5 15M3 2h8" /> break;
        case "download": <path d="M12 3v12m-5-5 5 5 5-5M4 17v4h16v-4" /> break;
        case "check": <path d="m5 12 4 4L19 6" /> break;
        case "close": <path d="m6 6 12 12M6 18 18 6" /> break;
        case "plus": <path d="M12 4v16M4 12h16" /> break;
        case "minus": <path d="M4 12h16" /> break;
        case "down": <path d="m6 9 6 6 6-6" /> break;
        case "back": <path d="m14 5-7 7 7 7" /> break;
        case "arrow": <path d="M4 12h16m-6-6 6 6-6 6" /> break;
        case "shuffle": <path d="M3 6h3c4 0 8 12 12 12h3m-4-4 4 4-4 4M3 18h3c1.5 0 3-2 4-4m4-4c1-2 2.5-4 4-4h3m-4-4 4 4-4 4" /> break;
        case "repeat": <path d="m17 2 4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4m14-1v2a3 3 0 0 1-3 3H3" /> break;
        case "queue": <path d="M4 5h16M4 11h11M4 17h8m5-2 5 3-5 3z" /> break;
        case "music": <path d="M9 18V5l11-2v13M9 9l11-2" /><ellipse cx="6" cy="18" rx="3" ry="2.5" /><ellipse cx="17" cy="16" rx="3" ry="2.5" /> break;
        case "headphones": <path d="M4 14v-3a8 8 0 0 1 16 0v3" /><rect x="3" y="12" width="4" height="9" rx="2" /><rect x="17" y="12" width="4" height="9" rx="2" /> break;
        case "sun": <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /> break;
        case "moon": <path d="M20 14A8 8 0 0 1 10 4a8.5 8.5 0 1 0 10 10Z" /> break;
        case "trash": <path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v6m4-6v6" /> break;
        case "retry": <path d="M4 9a8 8 0 1 1 0 7M4 3v6h6" /> break;
        case "alert": <path d="m12 3 10 18H2zM12 9v5m0 3v.1" /> break;
        case "offline": <circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" /> break;
        case "wave": <path d="M3 10v4m4-7v10m5-14v18m5-14v10m4-7v4" stroke-width="2.5" /> break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "music";
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public string Class { get; set; } = string.Empty;
}
