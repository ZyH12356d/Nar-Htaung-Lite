@inject IJSRuntime JS
@implements IAsyncDisposable

<dialog class="collection-dialog" @ref="_element" aria-labelledby="@_titleId">
    <div class="collection-dialog-heading"><div><p class="eyebrow">@Eyebrow</p><h2 id="@_titleId">@Title</h2></div><button class="icon-button" @onclick="RequestClose" disabled="@Busy" aria-label="Close dialog"><AppIcon Name="close" Size="22" /></button></div>
    @ChildContent
</dialog>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Eyebrow { get; set; } = "YOUR MUSIC";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private readonly string _titleId = "dialog-" + Guid.NewGuid().ToString("N");
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<AppDialog>? _reference;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _reference = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./dialogs.js");
        await _module.InvokeVoidAsync("show", _element, _reference);
    }
    [JSInvokable] public Task RequestClose() => Busy ? Task.CompletedTask : OnClose.InvokeAsync();
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("close", _element); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _reference?.Dispose();
    }
}
