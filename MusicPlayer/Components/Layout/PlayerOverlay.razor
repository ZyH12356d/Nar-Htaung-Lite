@inject MusicPlayer.Services.PlayerService PlayerService
@inject MusicPlayer.Services.LibraryService Library
@implements IDisposable
@if (PlayerService.CurrentSong is { } song)
{
    <section class="mini-player" aria-label="Mini player" inert="@PlayerService.IsPlayerExpanded">
        <button class="mini-player-track" @onclick="Expand" aria-label="Open player for @song.Title"><TrackArtwork Source="@song.ArtworkSource" Title="@song.Title" Eager="true" Class="mini-cover" /><span><strong>@song.Title</strong><small>@song.Author</small></span></button>
        <button class="icon-button mini-previous" @onclick="PlayerService.PlayPrevious" aria-label="Previous track"><AppIcon Name="previous" Size="22" /></button>
        <button class="mini-play-button" @onclick="PlayerService.TogglePlayPause" aria-label="@(PlayerService.IsPlaying ? "Pause" : "Play")"><AppIcon Name="@(PlayerService.IsPlaying ? "pause" : "play")" Size="21" /></button>
        <button class="icon-button mini-next" @onclick="PlayerService.PlayNext" aria-label="Next track"><AppIcon Name="next" Size="22" /></button>
        <ProgressBar Compact="true" />
    </section>
    @if (PlayerService.IsPlayerExpanded) { <NowPlaying Close="Collapse" /> }
}
@code {
    protected override void OnInitialized() { PlayerService.PropertyChanged += PlayerChanged; Library.LibraryUpdated += LibraryChanged; }
    private void PlayerChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) { if (e.PropertyName != nameof(PlayerService.CurrentPosition)) _ = InvokeAsync(StateHasChanged); }
    private void LibraryChanged() => _ = InvokeAsync(StateHasChanged);
    private void Expand() => PlayerService.IsPlayerExpanded = true;
    private void Collapse() => PlayerService.IsPlayerExpanded = false;
    public void Dispose() { PlayerService.PropertyChanged -= PlayerChanged; Library.LibraryUpdated -= LibraryChanged; }
}
