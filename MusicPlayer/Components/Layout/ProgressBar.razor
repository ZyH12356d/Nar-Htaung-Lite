@inject MusicPlayer.Services.PlayerService PlayerService
@implements IDisposable
@if (Compact)
{
    <div class="mini-progress" aria-hidden="true"><span style="width:@Percent%"></span></div>
}
else
{
    <div class="seek-container">
        <input type="range" class="seek-input" aria-label="Seek through track" min="0" max="@Number(Math.Max(0, PlayerService.Duration))" step="0.1" value="@Number(Position)" style="--seek-progress: @Percent%" disabled="@(PlayerService.Duration <= 0)" @oninput="OnDrag" @onchange="OnSeekEnd" @onpointercancel="() => _dragging = false" />
        <div class="seek-times"><span>@FormatTime(Position)</span><span>@FormatTime(PlayerService.Duration)</span></div>
    </div>
}
@code {
    [Parameter] public bool Compact { get; set; }
    private bool _dragging;
    private double _dragPosition;
    private double Position => _dragging ? _dragPosition : PlayerService.CurrentPosition;
    private string Percent => Number(PlayerService.Duration > 0 ? Math.Clamp(Position / PlayerService.Duration * 100, 0, 100) : 0);
    private static string Number(double value) => (double.IsFinite(value) ? value : 0).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    protected override void OnInitialized() => PlayerService.PropertyChanged += PlayerChanged;
    private void PlayerChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(PlayerService.CurrentPosition) or nameof(PlayerService.Duration) or nameof(PlayerService.CurrentSong)) _ = InvokeAsync(StateHasChanged);
    }
    private void OnDrag(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var position)) { _dragging = true; _dragPosition = position; }
    }
    private void OnSeekEnd(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var position)) PlayerService.Seek(position);
        _dragging = false;
    }
    private static string FormatTime(double seconds) { var time = TimeSpan.FromSeconds(double.IsFinite(seconds) ? Math.Max(0, seconds) : 0); return $"{(int)time.TotalMinutes}:{time.Seconds:D2}"; }
    public void Dispose() => PlayerService.PropertyChanged -= PlayerChanged;
}
