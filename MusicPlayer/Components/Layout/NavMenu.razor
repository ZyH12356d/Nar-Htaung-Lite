@inject MusicPlayer.Services.DownloadService DownloadService
@implements IDisposable

<nav class="bottom-nav" aria-label="Main navigation">
    <NavLink class="nav-item" href="/" Match="NavLinkMatch.All"><AppIcon Name="home" /><span>Home</span></NavLink>
    <NavLink class="nav-item" href="/search"><AppIcon Name="search" /><span>Search</span></NavLink>
    <NavLink class="nav-item" href="/album"><AppIcon Name="library" /><span>Collection</span></NavLink>
    <NavLink class="nav-item" href="/downloads"><span class="nav-icon-wrap"><AppIcon Name="download" />@if (_active > 0) { <span class="nav-badge">@_active</span> }</span><span>Downloads</span></NavLink>
</nav>

@code {
    private int _active;
    protected override void OnInitialized()
    {
        _active = DownloadService.ActiveDownloadCount;
        DownloadService.DownloadsChanged += Refresh;
    }
    private void Refresh() => _ = InvokeAsync(() => { _active = DownloadService.ActiveDownloadCount; StateHasChanged(); });
    public void Dispose() => DownloadService.DownloadsChanged -= Refresh;
}
