@page "/"
@using MusicPlayer.Models
<PageTitle>Home · Nar Htaung Lite</PageTitle>

<section class="page home-page">
    <div class="page-heading home-heading">
        <div><p class="eyebrow">YOUR PERSONAL SOUNDTRACK</p><h1>Music for<br /><span class="accent-text">your moments.</span></h1><p class="page-description">Your favorites. Saved here. Always with you.</p></div>
        <div class="hero-record" aria-hidden="true"><div><AppIcon Name="wave" Size="36" /></div></div>
    </div>
    @if (_loading)
    {
        <div class="loading-state" role="status"><span class="spinner"></span>Opening your library…</div>
    }
    else if (!LibraryService.Songs.Any())
    {
        <div class="empty-state library-empty"><span class="empty-icon"><AppIcon Name="headphones" Size="38" /></span><h2>A little quiet in here.</h2><p>Find a song you love and make it the first<br />track in your offline collection.</p><a class="button button-primary" href="/search"><AppIcon Name="search" Size="18" /> Find your music</a></div>
    }
    else
    {
        <div class="library-summary"><span><AppIcon Name="offline" Size="16" />@LibraryService.Songs.Count tracks, ready offline</span><button class="button button-primary small-button" @onclick="ShuffleAll"><AppIcon Name="shuffle" Size="17" />Shuffle</button></div>
        <CollectionShelf />
        <section class="recent-section" aria-labelledby="recent-title">
            <div class="section-heading"><h2 id="recent-title">Fresh in your library</h2><span class="muted">Recently saved</span></div>
            <div class="cover-carousel">
                @foreach (var song in LibraryService.Songs.Take(6))
                {
                    <button class="album-card" @onclick="() => PlayAndExpand(song)">
                        <span class="album-card-art"><TrackArtwork Source="@song.ArtworkSource" Title="@song.Title" /><span class="card-play"><AppIcon Name="play" Size="20" /></span></span>
                        <strong>@song.Title</strong><span>@song.Author</span>
                    </button>
                }
            </div>
        </section>
        <section aria-labelledby="tracks-title">
            <div class="section-heading"><h2 id="tracks-title">All tracks <span class="count-label">@LibraryService.Songs.Count</span></h2></div>
            <label class="search-field library-filter"><AppIcon Name="search" Size="19" /><input type="search" aria-label="Filter your library" placeholder="Find something in your library" @bind="_filter" @bind:event="oninput" /></label>
            <div class="track-list">
                @foreach (var song in FilteredSongs)
                {
                    <TrackRow @key="song.FilePath" Song="song" Active="@(PlayerService.CurrentSong?.FilePath == song.FilePath)" Playing="PlayerService.IsPlaying" OnPlay="PlayAndExpand" OnDelete="AskDelete" />
                }
            </div>
            @if (!FilteredSongs.Any()) { <p class="inline-empty">No tracks match “@_filter”.</p> }
        </section>
    }
    @if (!_loading && !LibraryService.Songs.Any()) { <CollectionShelf /> }
</section>

@if (_songToDelete is not null)
{
    <div class="modal-backdrop" @onclick="CancelDelete">
        <section class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-title" @onclick:stopPropagation="true">
            <span class="empty-icon danger"><AppIcon Name="trash" Size="26" /></span><h2 id="delete-title">Remove this track?</h2><p>“@_songToDelete.Title” will be deleted from your device.</p>
            <div class="dialog-actions"><button class="button button-secondary" @onclick="CancelDelete">Keep track</button><button class="button button-danger" @onclick="ConfirmDelete">Delete track</button></div>
        </section>
    </div>
}
