@page "/downloads"
@using MusicPlayer.Models
@using System.ComponentModel
@using System.Collections.Specialized
@inject MusicPlayer.Services.DownloadService DownloadService
@implements IDisposable
<PageTitle>Downloads · Nar Htaung Lite</PageTitle>
<section class="page">
    <div class="page-heading"><p class="eyebrow">TAKE YOUR MUSIC WITH YOU</p><h1>Downloads<span class="accent-text">.</span></h1><p class="page-description">A little preparation for a lot of listening.</p></div>
    <div class="download-summary"><span class="summary-icon"><AppIcon Name="offline" Size="25" /></span><div><strong>@CompletedCount @(CompletedCount == 1 ? "download" : "downloads") complete</strong><span>@(DownloadService.ActiveDownloadCount > 0 ? $"{DownloadService.ActiveDownloadCount} in the queue" : "Ready for your next offline moment")</span></div><button class="text-button" @onclick="DownloadService.ClearHistory" disabled="@(!DownloadService.Downloads.Any(d => d.Status is DownloadStatus.Completed or DownloadStatus.Failed))">Clear finished</button></div>
    <div class="filter-tabs" aria-label="Filter downloads">@foreach (var filter in Filters) { <button class="filter-tab @(_filter == filter ? "active" : "")" @onclick="() => _filter = filter" aria-pressed="@(_filter == filter)">@filter @if (filter == "All" && DownloadService.Downloads.Count > 0) { <span>@DownloadService.Downloads.Count</span> }</button> }</div>
    @if (!VisibleDownloads.Any())
    {
        <div class="empty-state"><span class="empty-icon"><AppIcon Name="download" Size="35" /></span><h2>@(_filter == "All" ? "Your next listen starts here." : "Nothing here right now.")</h2><p>@(_filter == "All" ? "Find a song and tap download. We’ll take care of the rest." : "Downloads with this status will appear here.")</p>@if (_filter == "All") { <a class="button button-primary" href="/search">Find a track <AppIcon Name="arrow" Size="18" /></a> }</div>
    }
    else
    {
        <div class="downloads-list" aria-live="polite">
            @foreach (var item in VisibleDownloads)
            {
                <article class="download-card" @key="item">
                    <div class="download-card-top"><TrackArtwork Source="@item.ThumbnailUrl" Title="@item.Title" Class="download-cover" /><div class="download-copy"><h2>@item.Title</h2><p>@item.Author</p><span class="status-label status-@item.Status.ToString().ToLowerInvariant()"><AppIcon Name="@StatusIcon(item.Status)" Size="14" />@StatusText(item.Status)</span></div>@if (item.Status == DownloadStatus.Failed) { <button class="icon-button" @onclick="() => DownloadService.Retry(item)" aria-label="Retry @item.Title"><AppIcon Name="retry" Size="20" /></button> }</div>
                    @if (item.Status is DownloadStatus.Downloading or DownloadStatus.Processing or DownloadStatus.Waiting)
                    {
                        <div class="download-progress-row"><div class="download-progress @(item.Status == DownloadStatus.Processing ? "indeterminate" : "")"><span style="width: @CssPercent(item.Progress)%"></span></div><span>@(item.Status == DownloadStatus.Downloading ? $"{item.Progress:0}%" : item.Status == DownloadStatus.Waiting ? "Queued" : "Preparing")</span></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.ErrorMessage)) { <p class="download-message @(item.Status == DownloadStatus.Failed ? "is-error" : "")">@item.ErrorMessage</p> }
                </article>
            }
        </div>
    }
</section>
@code {
    private static readonly string[] Filters = { "All", "Active", "Saved", "Failed" };
    private string _filter = "All";
    private readonly HashSet<DownloadItem> _subscribed = new();
    private int CompletedCount => DownloadService.Downloads.Count(d => d.Status == DownloadStatus.Completed);
    private IEnumerable<DownloadItem> VisibleDownloads => DownloadService.Downloads.Where(d => _filter switch { "Active" => d.Status is DownloadStatus.Waiting or DownloadStatus.Processing or DownloadStatus.Downloading, "Saved" => d.Status == DownloadStatus.Completed, "Failed" => d.Status == DownloadStatus.Failed, _ => true });
    protected override void OnInitialized()
    {
        DownloadService.Downloads.CollectionChanged += CollectionChanged; DownloadService.DownloadsChanged += Refresh; BindItems();
    }
    private void BindItems()
    {
        foreach (var old in _subscribed.Where(d => !DownloadService.Downloads.Contains(d)).ToList()) { old.PropertyChanged -= ItemChanged; _subscribed.Remove(old); }
        foreach (var item in DownloadService.Downloads.Where(d => !_subscribed.Contains(d))) { item.PropertyChanged += ItemChanged; _subscribed.Add(item); }
    }
    private void CollectionChanged(object? sender, NotifyCollectionChangedEventArgs e) { BindItems(); Refresh(); }
    private void ItemChanged(object? sender, PropertyChangedEventArgs e) => Refresh();
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    private static string StatusIcon(DownloadStatus status) => status switch { DownloadStatus.Completed => "check", DownloadStatus.Failed => "alert", DownloadStatus.Waiting => "queue", _ => "download" };
    private static string StatusText(DownloadStatus status) => status switch { DownloadStatus.Completed => "Saved offline", DownloadStatus.Failed => "Needs attention", DownloadStatus.Waiting => "Waiting", DownloadStatus.Processing => "Preparing audio", _ => "Downloading" };
    private static string CssPercent(double value) => Math.Clamp(value, 0, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    public void Dispose()
    {
        DownloadService.Downloads.CollectionChanged -= CollectionChanged; DownloadService.DownloadsChanged -= Refresh;
        foreach (var item in _subscribed) item.PropertyChanged -= ItemChanged;
    }
}
